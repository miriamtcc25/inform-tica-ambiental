value="on" class="HGrYIk8n" id="_r_1rr_" data-d-component="checkbox"></button><label for="_r_1rr_" class="ormz6UZ3 zdjApaRA"><span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(13, 13, 13);">He desarrollado qué es Green IT</span></span></label></div><div data-has-label="" data-orientation="left" class="hHfb6xfS tuMRJ86X"><button type="button" role="checkbox" aria-checked="false" data-state="unchecked" value="on" class="HGrYIk8n" id="_r_1rs_" data-d-component="checkbox"></button><label for="_r_1rs_" class="ormz6UZ3 zdjApaRA"><span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(13, 13, 13);">He explicado los objetivos y ventajas de Green IT</span></span></label></div><div data-has-label="" data-orientation="left" class="hHfb6xfS tuMRJ86X"><button type="button" role="checkbox" aria-checked="false" data-state="unchecked" value="on" class="HGrYIk8n" id="_r_1rt_" data-d-component="checkbox"></button><label for="_r_1rt_" class="ormz6UZ3 zdjApaRA"><span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(13, 13, 13);">He escrito medidas de informática sostenible</span></span></label></div><div data-has-label="" data-orientation="left" class="hHfb6xfS tuMRJ86X"><button type="button" role="checkbox" aria-checked="false" data-state="unchecked" value="on" class="HGrYIk8n" id="_r_1ru_" data-d-component="checkbox"></button><label for="_r_1ru_" class="ormz6UZ3 zdjApaRA"><span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(13, 13, 13);">He añadido la tabla Markdown</span></span></label></div><div data-has-label="" data-orientation="left" class="hHfb6xfS tuMRJ86X"><button type="button" role="checkbox" aria-checked="false" data-state="unchecked" value="on" class="HGrYIk8n" id="_r_1rv_" data-d-component="checkbox"></button><label for="_r_1rv_" class="ormz6UZ3 zdjApaRA"><span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(13, 13, 13);">He creado el diagrama Mermaid</span></span></label></div><div data-has-label="" data-orientation="left" class="hHfb6xfS tuMRJ86X"><button type="button" role="checkbox" aria-checked="false" data-state="unchecked" value="on" class="HGrYIk8n" id="_r_1s0_" data-d-component="checkbox"></button><label for="_r_1s0_" class="ormz6UZ3 zdjApaRA"><span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(13, 13, 13);">He redactado la conclusión general</span></span></label></div><div data-has-label="" data-orientation="left" class="hHfb6xfS tuMRJ86X"><button type="button" role="checkbox" aria-checked="false" data-state="unchecked" value="on" class="HGrYIk8n" id="_r_1s1_" data-d-component="checkbox"></button><label for="_r_1s1_" class="ormz6UZ3 zdjApaRA"><span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(13, 13, 13);">He añadido 2 imágenes</span></span></label></div><div data-has-label="" data-orientation="left" class="hHfb6xfS tuMRJ86X"><button type="button" role="checkbox" aria-checked="false" data-state="unchecked" value="on" class="HGrYIk8n" id="_r_1s2_" data-d-component="checkbox"></button><label for="_r_1s2_" class="ormz6UZ3 zdjApaRA"><span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(13, 13, 13);">He incluido referencias y enlaces fiables</span></span></label></div><div data-has-label="" data-orientation="left" class="hHfb6xfS tuMRJ86X"><button type="button" role="checkbox" aria-checked="false" data-state="unchecked" value="on" class="HGrYIk8n" id="_r_1s3_" data-d-component="checkbox"></button><label for="_r_1s3_" class="ormz6UZ3 zdjApaRA"><span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(13, 13, 13);">He subido mis cambios mediante commits</span></span></label></div><div data-has-label="" data-orientation="left" class="hHfb6xfS tuMRJ86X"><button type="button" role="checkbox" aria-checked="false" data-state="unchecked" value="on" class="HGrYIk8n" id="_r_1s4_" data-d-component="checkbox"></button><label for="_r_1s4_" class="ormz6UZ3 zdjApaRA"><span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(13, 13, 13);">He comprobado que el diagrama se renderiza</span></span></label></div><div data-has-label="" data-orientation="left" class="hHfb6xfS tuMRJ86X"><button type="button" role="checkbox" aria-checked="false" data-state="unchecked" value="on" class="HGrYIk8n" id="_r_1s5_" data-d-component="checkbox"></button><label for="_r_1s5_" class="ormz6UZ3 zdjApaRA"><span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(13, 13, 13);">He comprobado que las imágenes se ven correctamente</span></span></label></div><div data-has-label="" data-orientation="left" class="hHfb6xfS tuMRJ86X"><button type="button" role="checkbox" aria-checked="false" data-state="unchecked" value="on" class="HGrYIk8n" id="_r_1s6_" data-d-component="checkbox"></button><label for="_r_1s6_" class="ormz6UZ3 zdjApaRA"><span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(13, 13, 13);">He revisado la ortografía</span></span></label></div><div class="aIXBUsFA" data-d-component="divider" style="--divider-color: var(--color-border-subtle); --divider-size: 1px;"></div><p class="kDAqPLZc dOmvsSM7" data-d-text-flow="" data-d-component="text" data-d-weight="medium" style="color: var(--color-text-success);"><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(0, 105, 42);">0</span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(0, 105, 42);"> de </span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(0, 105, 42);">18</span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(0, 105, 42);"> completados</span></p></div><h1 class="kDAqPLZc ij922CZO" data-d-text-flow="" data-d-component="title" data-d-size="xl" data-d-weight="semibold"><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(13, 13, 13);"><strong class="BHzYtQdb">PASO 15. Revisar el trabajo entre las dos</strong></span></h1><p class="kDAqPLZc dOmvsSM7" data-d-text-flow="" data-d-component="text"><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(13, 13, 13);">Cuando ambas terminéis, entrad juntas en el repositorio y revisad:</span></p><ul class="bYalj1om" data-d-component="list" data-d-marker="none" data-d-marker-layout="custom" style="--d-list-row-gap: calc(var(--spacing, 0.25rem) * 0); gap: calc(var(--spacing, 0.25rem) * 0);"><li class="EWTmaRtl" data-d-component="list-item" data-d-marker-layout="custom"><div class="DbD0Oj0b"><div class="qdSQ_4Rw" data-d-list-item-content=""><div data-has-label="" data-orientation="left" class="hHfb6xfS tuMRJ86X"><button type="button" role="checkbox" aria-checked="false" data-state="unchecked" value="on" class="HGrYIk8n" id="_r_1s9_" data-d-component="checkbox"></button><label for="_r_1s9_" class="ormz6UZ3 zdjApaRA"><span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(13, 13, 13);">El README es la portada principal.</span></span></label></div></div></div></li><li class="EWTmaRtl" data-d-component="list-item" data-d-marker-layout="custom"><div class="DbD0Oj0b"><div class="qdSQ_4Rw" data-d-list-item-content=""><div data-has-label="" data-orientation="left" class="hHfb6xfS tuMRJ86X"><button type="button" role="checkbox" aria-checked="false" data-state="unchecked" value="on" class="HGrYIk8n" id="_r_1sa_" data-d-component="checkbox"></button><label for="_r_1sa_" class="ormz6UZ3 zdjApaRA"><span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(13, 13, 13);">El índice enlaza correctamente con los archivos.</span></span></label></div></div></div></li><li class="EWTmaRtl" data-d-component="list-item" data-d-marker-layout="custom"><div class="DbD0Oj0b"><div class="qdSQ_4Rw" data-d-list-item-content=""><div data-has-label="" data-orientation="left" class="hHfb6